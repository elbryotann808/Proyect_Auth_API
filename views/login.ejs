<%- include('partials/header') -%>
<div class="conteiner">
  <div class="form">
    <h1 class="form__title">Login</h1>
    
    <form class="form__form-data" id="loginForm">
      <div class="form__container-inputs">

        <label for="email">Email</label>
        <input class="form__input" id="email" name="email" type="email" required>
    
        <label for="password">Password</label>
        <input class="form__input" id="password" name="password" type="password" required>
        
        <p class="form__ask-user">Neeed to sing in? <span><a class="form__link-user" href="/register">Register here</a></span></p>
        <div id="apiResult" aria-live="polite"></div>
      </div>

      <div class="form__containter-btn">
        <button class="form__btn-submit" type="submit">Submit</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/login.js"></script>

<%- include('partials/footer') -%>
